{
  "permissions": {
    "allow": [
      "Bash(npm ci:*)",
      "Bash(npm install:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run verify:*)",
      "Bash(npm run dist:*)",
      "Bash(npm audit:*)",
      "Bash(npx playwright:*)",
      "Bash(npx electron-builder:*)",
      "Bash(node scripts/:*)",
      "Bash(node test/:*)",
      "Bash(node --test:*)",
      "Bash(xvfb-run:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git push -u origin claude/*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(wc:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf /:*)",
      "Read(./group.key)",
      "Edit(./group.key)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/claude-setup.sh\"", "timeout": 600 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/claude-stop-check.sh\"", "timeout": 300 } ] }
    ]
  }
}
