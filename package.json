{
  "name": "humblechat",
  "productName": "HumbleChat",
  "version": "0.1.0",
  "description": "Chat de texto y voz privado para un grupo pequeño de amigos. Sin servidor, sin cuentas, sin configuración.",
  "main": "src/main/main.js",
  "license": "MIT",
  "author": "HumbleChat",
  "private": true,
  "scripts": {
    "start": "node scripts/ensure-key.js && electron .",
    "test": "node --test test/core.test.js",
    "test:e2e": "node test/e2e.js",
    "dist:win": "node scripts/build.js win",
    "dist:linux": "node scripts/build.js linux",
    "dist": "node scripts/build.js all",
    "dist:all": "node scripts/build.js all",
    "test:smoke": "node test/smoke.js",
    "dist:public": "node scripts/build.js all --public"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "hyperdht": "^6.21.0",
    "hyperswarm": "^4.17.2"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "playwright": "~1.63.0"
  },
  "homepage": "https://github.com/SergioGuillenRuiz/HumbleChat",
  "desktopName": "humblechat.desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/SergioGuillenRuiz/HumbleChat.git"
  }
}
